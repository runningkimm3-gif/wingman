{
  "manifest_version": 3,
  "name": "Cupid — AI Wingman",
  "version": "2.0.0",
  "description": "Premium AI dating co-pilot.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://*.messenger.com/*",
    "https://*.facebook.com/messages*",
    "https://*.instagram.com/direct*",
    "https://web.telegram.org/*",
    "https://web.whatsapp.com/*",
    "https://*.x.com/messages*",
    "https://*.twitter.com/messages*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.messenger.com/*",
        "https://*.facebook.com/messages*",
        "https://*.instagram.com/direct*",
        "https://web.telegram.org/*",
        "https://web.whatsapp.com/*",
        "https://*.x.com/messages*",
        "https://*.twitter.com/messages*",
        "file:///*"
      ],
      "js": [
        "adapters/base.js",
        "adapters/messenger.js",
        "adapters/instagram.js",
        "adapters/telegram.js",
        "adapters/whatsapp.js",
        "adapters/x.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
