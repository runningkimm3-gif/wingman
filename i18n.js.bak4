/**
 * @fileoverview Internationalization (i18n) module for Cupid Extension.
 * Stores all translatable strings, keyed by language code.
 */

const translations = {
    // English locale
    en: {
        appName: "Cupid — AI Wingman",
        description: "Premium AI dating co-pilot.",
        apiTitle: "Authentication",
        apiKeyPlaceholder: "gsk_...",
        getApiKeyBtnText: "Get Groq API Key ↗",
