        argueVibe: "🗣️ ငြင်းခုံခြင်း", // Arguing
        persuadeVibe: "🧠 ယ thuyếtကျအောင်လုပ်ခြင်း", // Persuading
        generateBtnText: "ထုတ်ပေးရန်", // Generate
        copyBtnText: "ကူးယူမည်", // Copy
        executeBtnText: "အသုံးပြုမည်", // Execute
        apiErrorKey: "API Key မရှိပါ",
        apiErrorMsg: "API Key လိုအပ်ပါသည်။",
        runtimeErrorPrefix: "[အမှား]",
        noResponseMessage: "နောက်ခံစကရစ်ပ်က တုံ့ပြန်မှုမပေးခဲ့ပါ။"
    }
};

/**
 * Retrieves the translation for a given key and language.
 * @param {string} lang - The language code ('en' or 'my').
 * @param {string} key - The translation key.
 * @returns {string | null} The translated string, or null if not found.
 */
function t(lang, key) {
    const translationsByLang = translations[lang];
    if (translationsByLang && translationsByLang[key]) {
        return translationsByLang[key];
    }
    // Fallback to English if translation is missing or language is unsupported
    console.warn(`Translation key "${key}" not found for language "${lang}". Falling back to 'en'.`);
    const fallback = translations['en'];
    if (fallback && fallback[key]) {
        return fallback[key];
    }
    return `[MISSING_TRANSLATION:${key}]`;
}

// Expose the translation function globally or module-wise for use in content.js
window.t = t;