        argueVibe: "🗣️ Argue",
        persuadeVibe: "🧠 Persuade",
        generateBtnText: "Generate",
        copyBtnText: "Copy",
        executeBtnText: "Execute",
        apiErrorKey: "MISSING_KEY",
        apiErrorMsg: "API Key is required.",
        runtimeErrorPrefix: "[ERROR]",
        noResponseMessage: "Background script did not respond."
    },

    // Myanmar locale (Burmese)
    my: {
        appName: "ကူပစ် — AI Wingman", // Cupid - AI Wingman in Burmese
        description: "အဆင့်မြင့် AI ချိန်းတွေ့ခြင်း အဖော်အဖြစ်။", // Premium AI dating co-pilot.
        apiTitle: "အထောက်အထားစစ်ဆေးမှု", // Authentication
        apiKeyPlaceholder: "gsk_...",
        getApiKeyBtnText: "Groq API Key ရယူရန် ↗", // Get Groq API Key
        autoPilotLabel: "အလိုအလျောက် အကောင်အထရုပ် စနစ်", // Auto-Pilot Protocol
        autoDirectionLabel: "ညွှန်ကြားချက် (ရွေးချယ်နိုင်သည်)", // Directive (Optional)
        responseMatrixTitle: "တုံ့ပြန်မှု ပုံစံများ", // Response Matrix
        normalVibe: "ပုံမှန်", // Normal
        teaseVibe: "🌶️ စနောက်ခြင်း", // Teasing
        chillVibe: "🧊 အေးအေးဆေးဆေး", // Chill
