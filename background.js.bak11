const GROQ_URL = 'https://api.groq.com/openai/v1/chat/completions';
const DEFAULT_MODEL = 'openai/gpt-oss-120b';

function hasBurmese(text) {
  return /[\u1000-\u109F]/.test(text || '');
}
function burmeseRatio(text) {
  if (!text) return 0;
  const chars = text.replace(/\s+/g, '');
  if (!chars) return 0;
  const m = chars.match(/[\u1000-\u109F]/g);
  return (m ? m.length : 0) / chars.length;
}

chrome.runtime.onMessage.addListener((request, sender, sendResponse) => {
  if (request.type !== 'GENERATE_REPLIES') return false;

  (async () => {
    try {
      const { apiKey, partnerName, messages, replyStyle, autoDirection, globalStyle } = request.payload;

      if (!apiKey) { sendResponse({ error: 'MISSING_KEY', message: 'Please add your Groq API key.' }); return; }
      const herMessages = messages.filter(m => m.from === 'them');
      if (herMessages.length === 0) { sendResponse({ error: 'NO_MSG', message: 'She has not sent any messages yet.' }); return; }

      const stored = await chrome.storage.local.get('cupid_model');
      const modelToUse = stored.cupid_model || DEFAULT_MODEL;

      const lastMessageFromHer = herMessages[herMessages.length - 1].text;
      const lastIsBurmese = hasBurmese(lastMessageFromHer);
      const formattedHistory = messages.slice(-40).map(m => `${m.from === 'me' ? 'Me' : partnerName}: ${m.text}`).join('\n');
      const myCurrentChatMessages = messages.filter(m => m.from === 'me').map(m => m.text);

      const herBurmeseCount = herMessages.filter(m => hasBurmese(m.text)).length;
      const herLanguage = lastIsBurmese ? 'BURMESE' :
                          herBurmeseCount > herMessages.length / 2 ? 'BURMESE (mixed)' : 'ENGLISH';
      const mustReplyBurmese = lastIsBurmese || herBurmeseCount > herMessages.length / 3;

      const herLengths = herMessages.map(m => m.text.length);
      const herAvgLen = herLengths.length ? Math.round(herLengths.reduce((a,b)=>a+b,0)/herLengths.length) : 0;
      const herUsesEmoji = herMessages.some(m => /[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/u.test(m.text));
      const herQuestions = herMessages.filter(m => /[?\uFF1F]/.test(m.text)).slice(-3).map(m => m.text);

      const fullText = messages.map(m => m.text).join(' ');
      const topicPatterns = {
        food: /(food|eat|hungry|restaurant|coffee|tea|\u1011\u1019\u1004\u103A\u1038|\u1005\u102C\u1038|\u1000\u1031\u102C\u103A\u1016\u102E)/i,
        work: /(work|office|job|busy|meeting|\u1021\u101C\u102F\u1015\u103A|\u101B\u102F\u1036\u1038)/i,
        sleep: /(sleep|tired|\u1021\u102D\u1015\u103A|\u1015\u1004\u103A\u1015\u1014\u103A\u1038)/i,
        meetup: /(meet|hangout|go out|\u1010\u103D\u1031\u1037|\u1006\u102F\u1036|\u1011\u103D\u1000\u103A)/i,
        feelings: /(miss|love|like you|\u1001\u103B\u1005\u103A|\u101C\u103D\u1019\u103A\u1038|\u101E\u1018\u1031\u102C\u103A\u1000\u103B)/i
      };
      const topics = [];
      for (const [t, p] of Object.entries(topicPatterns)) if (p.test(fullText)) topics.push(t);

      let trend = 'stable';
      if (herMessages.length >= 6) {
        const half = Math.floor(herMessages.length / 2);
        const firstAvg = herMessages.slice(0, half).reduce((a,m)=>a+m.text.length,0) / half;
        const secondAvg = herMessages.slice(half).reduce((a,m)=>a+m.text.length,0) / (herMessages.length - half);
        if (secondAvg > firstAvg * 1.3) trend = 'warming up';
        else if (secondAvg < firstAvg * 0.7) trend = 'cooling down';
      }

      const analysisBlock = `HER PROFILE:
- Language of her last message: ${lastIsBurmese ? 'BURMESE' : 'ENGLISH'}
- Overall chat language: ${herLanguage}
- Avg message length: ${herAvgLen} chars
- Emoji: ${herUsesEmoji ? 'yes' : 'no'}
- Count: her ${herMessages.length} / him ${myCurrentChatMessages.length}
- Trend: ${trend}
${topics.length ? '- Topics: ' + topics.join(', ') : ''}
${herQuestions.length ? '- Her recent questions:\n' + herQuestions.map((q,i)=>`  ${i+1}. "${q}"`).join('\n') : ''}`;

      let styleContext = '';
      if (myCurrentChatMessages.length >= 3) {
        styleContext = `HIS EXACT STYLE:\n` +
          myCurrentChatMessages.slice(-20).map((t, i) => `  ${i + 1}. ${t}`).join('\n');
      } else if (globalStyle && globalStyle.length > 0) {
        styleContext = `HIS STYLE FROM OTHER CHATS:\n` +
          globalStyle.slice(0, 15).map((t, i) => `  ${i + 1}. ${t}`).join('\n');
      } else {
        styleContext = 'No samples — casual 20-something Yangon tone.';
      }

      let styleInstruction = '';
      if (replyStyle === 'tease') styleInstruction = 'Playful roast / \u101F\u102C\u1006\u101B\u102C style.';
      else if (replyStyle === 'chill') styleInstruction = 'Low investment, unbothered, short.';
      else if (replyStyle === 'flirty') styleInstruction = 'Smooth, romantic, move toward a date.';
      else if (replyStyle === 'argue') styleInstruction = 'Disagree, devil\'s advocate, cocky.';
      else if (replyStyle === 'persuade') styleInstruction = 'Convince her toward what you want.';
      else styleInstruction = 'Friendly but confident.';

      let directionInstruction = '';
      if (autoDirection && autoDirection.trim() !== '') {
        directionInstruction = `\nOVERRIDE: Steer conversation: "${autoDirection.trim()}".`;
      }

      const burmeseMode = mustReplyBurmese ? `
=== BURMESE MODE - STRICT (OVERRIDES EVERYTHING) ===

Her last message is in BURMESE. Replies MUST be in BURMESE. English-only replies = FAILURE.

PRONOUNS (mandatory):
- you = \u1014\u1004\u103A or \u1019\u1004\u103A\u1038    (NEVER \u1001\u1004\u103A\u1017\u103B\u102B\u1038, \u101B\u103E\u1004\u103A\u1037)
- I/me = \u1004\u102B or OMIT                       (NEVER \u1000\u103B\u103D\u1014\u103A\u1010\u1031\u102C\u103A, \u1000\u103B\u103D\u1014\u103A\u1019)
- Often best to omit pronouns completely

CASUAL ENDINGS ONLY:
  OK: \u101C\u102C\u1038  \u101C\u1032  \u1014\u1032\u1037  \u1018\u1030\u1038  \u1010\u101A\u103A  \u1019\u101A\u103A  \u101C\u102D\u102F\u1000\u103A  \u1015\u102B  \u101F  \u1000\u103D\u102C  \u101B\u101A\u103A  \u1016\u103C\u1005\u103A
  BAN: \u101E\u100A\u103A  \u1019\u100A\u103A  \u104F  \u1053  \u1015\u102B\u101E\u100A\u103A  \u101C\u1031\u101E\u100A\u103A

BANNED FORMAL WORDS (hard ban - never appear in output):
  \u1001\u1004\u103A\u1017\u103B\u102B\u1038  \u101B\u103E\u1004\u103A\u1037  \u1000\u103B\u103D\u1014\u103A\u1010\u1031\u102C\u103A  \u1000\u103B\u103D\u1014\u103A\u1019
  \u101E\u100A\u103A  \u1019\u100A\u103A  \u104F  \u1053  \u1015\u102B\u101E\u100A\u103A  \u1016\u103C\u1005\u103A\u1015\u102B\u101E\u100A\u103A
  \u101E\u1004\u103A\u101E\u100A\u103A  \u101E\u1004\u103A  \u1004\u102B\u1038  \u1012\u102E  \u1012\u102B  \u1019\u100A\u103A\u101E\u102D\u102F\u1037  \u1019\u100A\u103A\u101E\u100A\u103A\u1037  \u1021\u1018\u101A\u103A

GOOD EXAMPLES - memorize this register:
  Her: \u1018\u102C\u101C\u102F\u1015\u103A\u1014\u1031\u101C\u1032         -> "u \u1000\u102D\u102F\u1019\u103E \u1005\u102E\u1038\u1005\u102C\u1038\u1014\u1031\u1010\u102C" / "\u1021\u102D\u1015\u103A\u1014\u1031\u1010\u102C"
  Her: \u101F\u102F\u1010\u103A\u101C\u102C\u1038             -> "\u101F\u102F\u1010\u103A\u1010\u101A\u103A\u101C\u1031 \u1014\u1004\u103A\u1019\u101A\u103F\u1038\u1018\u1030\u1038\u101C\u102C\u1038"
  Her: \u1019\u1004\u103A\u1038\u1000 \u1010\u1031\u102C\u103A\u1010\u1031\u102C\u103A\u101C\u1031\u1038 \u1014\u1031\u102C\u1000\u103A\u1000\u103B\u1010\u101A\u103A -> "\u1021\u102D\u102F\u1000\u1031 \u1021\u102D\u102F\u1000\u1031 \u1004\u102B\u1019\u103E\u102C\u1038\u1010\u101A\u103A" / "\u1014\u1004\u103A\u1000\u102D\u102F \u1005\u1031\u102C\u1004\u103A\u1037\u1014\u1031\u1010\u102C\u101C\u1031"
  Her: \u1018\u101A\u103A\u101E\u103D\u102C\u1038\u1019\u101C\u1032      -> "\u1014\u1004\u103A\u101C\u102C\u1001\u1032\u1037 \u1004\u102B\u1015\u103C\u1031\u102C\u103A\u1015\u103C\u1019\u103A"
  Her: \u101F\u102C\u1006\u101B\u102C\u1011\u102D\u1010\u102C        -> "\u101F\u102C\u1006\u101B\u102C\u1019\u101F\u102F\u1010\u103A\u1018\u1030\u1038 \u1014\u1004\u103A\u1010\u1031\u102C\u103A\u1019\u103E"

BAD EXAMPLES - never produce:
  X "\u1000\u103B\u103D\u1014\u103A\u1010\u1031\u102C\u103A \u1014\u1004\u103A\u1010\u1031\u102C\u103A\u1000\u102D\u102F \u101E\u1018\u1031\u102C\u103A\u1010\u101A\u103A"     (formal I + formal ending)
  X "\u1001\u1004\u103A\u1017\u103B\u102B\u1038 \u1018\u101A\u103A\u101C\u102D\u102F\u1014\u1031\u101C\u1032"            (formal you)
  X "\u101F\u102D\u1010\u103A\u101C\u102C\u1038 \u1000\u103C\u100A\u103A\u1019\u101A\u103A"                  (AI-translated feel)
  X "Hello how are you"                          (wrong language entirely)

MIXED ENGLISH (natural, OK):
  It is totally normal to slip short English: ok, lol, ngl, fr, hmm, true, ya, omg
  BUT the message body stays Burmese. "ok lol" alone is fine only for a 1-word reply.

TONE:
  Urban Yangon Gen-Z. Not textbook. Not translator output. Not formal \u1005\u102C.
  If unsure, keep replies SHORT — bad grammar in a short reply reads as slang, bad grammar in a long one reads as broken.
` : '';

      const systemPrompt = `You are ghostwriting a SPECIFIC real guy's texts - not an AI. Output goes to a real girl. If it sounds like AI, you fail.

=== HIS EXACT STYLE ===
${styleContext}

=== DEEP CHAT ANALYSIS ===
${analysisBlock}

=== FULL CHAT (last 40) ===
${formattedHistory}

=== HER LAST MESSAGE - replies MUST relate to THIS ===
"${lastMessageFromHer}"

${burmeseMode}

=== ANTI-GENERIC LAW ===
Every reply must pass: "Could this be sent to any girl in any chat?"
If YES -> WRONG. Rewrite. Anchor to a specific word from her message or a topic from chat.
BANNED STARTERS: haha, lol, lmao, yeah, true, fr, ngl, ok, okay, hmm, wow, oh, ah, sure.

=== THREE TONES - STRUCTURALLY DIFFERENT ===
Playful: QUESTION or CHALLENGE. Different opening word than Warm/Bold.
Warm: References a SPECIFIC detail from her message or earlier chat.
Bold: Contains a DIRECTIVE (propose, invite, call out). Not just a statement.

=== STYLE RULES ===
1. Output ONLY raw message text. No quotes, no narration.
2. Match HIS length (see HIS EXACT STYLE).
3. Match HIS punctuation (usually lowercase, no periods).
4. Only use emoji HE uses.
5. ${mustReplyBurmese ? 'Reply language MUST be BURMESE (see BURMESE MODE above).' : 'Reply language: match her last message.'}
6. Real Yangon voice.

STYLE TONE: ${styleInstruction}
${directionInstruction}

=== VIBE CHECK ===
vibe_score 1-5:
  1 = cold/dry/one-word
  2 = neutral/flat
  3 = warm/engaged
  4 = flirty/teasing/hints
  5 = hot/clearly into it
vibe_mood: warm | flirty | neutral | dry | confused | tense | cold
vibe_review: 1-2 sentences on her actual emotional state.
chat_insight: 1-sentence summary of the conversation arc.

=== SCAM DETECTION ===
Scan FULL chat: money requests, investment/crypto, fast-love escalation, off-platform pressure, personal info requests, emergency sob stories, dodge video calls, vague identity, copypasta grammar, early sexual asks, pressure tactics.
Be conservative - normal flirting is NOT a scam.

=== OUTPUT - STRICT JSON ===
{
  "vibe_score": 3,
  "vibe_mood": "warm",
  "vibe_review": "...",
  "chat_insight": "...",
  "scam_alert": { "detected": false, "confidence": 0, "red_flags": [], "advice": "" },
  "style_notes": "...",
  "playful": "...",
  "warm": "...",
  "bold": "...",
  "auto_reply": "..."
}`;

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 35000);

      const response = await fetch(GROQ_URL, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: modelToUse,
          messages: [
            { role: 'system', content: systemPrompt },
            { role: 'user', content: `Reply to "${lastMessageFromHer}". Each reply anchored to a specific detail. Vary openers. ${mustReplyBurmese ? 'MUST be in Burmese per BURMESE MODE.' : ''}` }
          ],
          response_format: { type: 'json_object' },
          temperature: 0.95,
          top_p: 0.95
        }),
        signal: controller.signal
      });

      clearTimeout(timeoutId);

      if (!response.ok) {
        let errMsg = `Groq Error: ${response.status}`;
        try { const e = await response.json(); errMsg = e?.error?.message || errMsg; } catch (e) {}
        sendResponse({ error: 'API_ERROR', message: errMsg });
        return;
      }

      const data = await response.json();
      try {
        const result = JSON.parse(data.choices[0].message.content);

        // Dedupe tones
        const seen = new Set();
        ['playful', 'warm', 'bold'].forEach(tone => {
          if (result[tone]) {
            const norm = result[tone].toLowerCase().trim();
            if (seen.has(norm)) result[tone] = null;
            else seen.add(norm);
          }
        });

        // Language guard - drop wrong-language replies
        if (mustReplyBurmese) {
          ['playful', 'warm', 'bold', 'auto_reply'].forEach(k => {
            const r = result[k];
            if (!r) return;
            const ratio = burmeseRatio(r);
            const words = r.trim().split(/\s+/).filter(Boolean).length;
            // Short replies (<4 words) in English are OK (natural "ok lol" style)
            // Longer replies must be mostly Burmese
            if (words >= 4 && ratio < 0.15) {
              result[k] = null;
            }
          });

          const left = ['playful', 'warm', 'bold'].filter(k => result[k]);
          if (left.length === 0) {
            sendResponse({ error: 'LANG_ERROR', message: 'AI replied in the wrong language. Tap Deal again.' });
            return;
          }
        }

        sendResponse(result);
      } catch (parseError) {
        console.error('Cupid Parse Error:', data.choices[0].message.content);
        sendResponse({ error: 'PARSE_ERROR', message: 'AI returned malformed response. Try again.' });
      }

    } catch (err) {
      sendResponse({ error: 'NETWORK', message: err.message });
    }
  })();

  return true;
});
